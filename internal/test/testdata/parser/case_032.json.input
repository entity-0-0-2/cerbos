# yaml-language-server: $schema=../../../../../schema/jsonschema/cerbos/policy/v1/Policy.schema.json
---
apiVersion: api.cerbos.dev/v1
principalPolicy:
  principal: donald*
  version: default
  rules:
    - resource: salary_record
      actions:
        - action: view
          effect: EFFECT_ALLOW
---
apiVersion: api.cerbos.dev/v1
rolePolicy:
  role: admin*
  version: default
  rules:
    - resource: leave_request
      allowActions:
        - view
